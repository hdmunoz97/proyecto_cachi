-- 1. TABLA DE EMPLEADOS
CREATE TABLE empleados (
    id_empleado SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    documento VARCHAR(30) UNIQUE NOT NULL,
    cargo VARCHAR(100) NOT NULL,
    max_horas_semanales DECIMAL(4,2) DEFAULT 48.00,
    activo BOOLEAN DEFAULT TRUE
);

-- 2. REGISTRO DE TURNOS DIARIOS
CREATE TABLE registro_horas (
    id_registro SERIAL PRIMARY KEY,
    id_empleado INTEGER NOT NULL REFERENCES empleados(id_empleado) ON DELETE CASCADE,
    fecha DATE NOT NULL DEFAULT CURRENT_DATE,
    hora_entrada TIME NOT NULL,
    hora_salida TIME NOT NULL,
    horas_trabajadas DECIMAL(5,2) NOT NULL,
    CHECK (horas_trabajadas > 0 AND horas_trabajadas <= 24)
);

-- 3. CONTROL DE HORAS EXTRA
CREATE TABLE horas_extra (
    id_hora_extra SERIAL PRIMARY KEY,
    id_empleado INTEGER NOT NULL REFERENCES empleados(id_empleado) ON DELETE CASCADE,
    id_registro INTEGER NOT NULL REFERENCES registro_horas(id_registro) ON DELETE CASCADE,
    horas_extra DECIMAL(5,2) NOT NULL,
    fecha DATE NOT NULL,
    estado VARCHAR(20) DEFAULT 'Pendiente',
    CHECK (horas_extra > 0),
    CHECK (estado IN ('Pendiente', 'Aprobado_RRHH', 'Pagada', 'Rechazada'))
);

-- 4. TABLA DE ALERTAS DE TECNOESTRÉS
CREATE TABLE alertas (
    id_alerta SERIAL PRIMARY KEY,
    id_empleado INTEGER NOT NULL REFERENCES empleados(id_empleado) ON DELETE CASCADE,
    fecha_alerta TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    nivel_riesgo VARCHAR(20) NOT NULL,
    mensaje VARCHAR(255) NOT NULL,
    horas_acumuladas DECIMAL(5,2) NOT NULL,
    atendida BOOLEAN DEFAULT FALSE,
    CHECK (nivel_riesgo IN ('Preventivo', 'Critico'))
);

-- 5. LÓGICA AUTOMÁTICA: TRIGGER DE ALERTAS Y HORAS EXTRA
CREATE OR REPLACE FUNCTION evaluar_tecnoestres()
RETURNS TRIGGER AS $$
DECLARE
    v_total_semana DECIMAL(5,2);
    v_max_horas DECIMAL(4,2);
    v_inicio_semana DATE;
BEGIN
    v_inicio_semana := DATE_TRUNC('week', NEW.fecha)::DATE;
    
    SELECT COALESCE(SUM(horas_trabajadas), 0) INTO v_total_semana
    FROM registro_horas
    WHERE id_empleado = NEW.id_empleado
      AND fecha BETWEEN v_inicio_semana AND (v_inicio_semana + INTERVAL '6 days')::DATE;

    SELECT max_horas_semanales INTO v_max_horas FROM empleados WHERE id_empleado = NEW.id_empleado;

    -- Si supera el límite semanal genera alerta y registra horas extra automáticamente
    IF v_total_semana > v_max_horas THEN
        INSERT INTO alertas (id_empleado, nivel_riesgo, mensaje, horas_acumuladas)
        VALUES (
            NEW.id_empleado,
            'Critico',
            'Límite de jornada excedido. Bloqueo preventivo para evitar fatiga laboral.',
            v_total_semana
        );
        
        INSERT INTO horas_extra (id_empleado, id_registro, horas_extra, fecha)
        VALUES (NEW.id_empleado, NEW.id_registro, (v_total_semana - v_max_horas), NEW.fecha);
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_evaluar_tecnoestres
AFTER INSERT ON registro_horas
FOR EACH ROW EXECUTE FUNCTION evaluar_tecnoestres();

-- 6. CONSULTA PARA POBLAR EL DASHBOARD EN EL FRONT-END
SELECT 
    e.id_empleado,
    e.nombre || ' ' || e.apellido AS mecanico,
    e.cargo,
    COALESCE(SUM(r.horas_trabajadas), 0) AS horas_semanales_acumuladas,
    e.max_horas_semanales,
    CASE 
        WHEN COALESCE(SUM(r.horas_trabajadas), 0) > e.max_horas_semanales THEN 'Alerta Crítica: Exceso de Jornada'
        WHEN COALESCE(SUM(r.horas_trabajadas), 0) >= 40 THEN 'Atención: Cerca del Límite'
        ELSE 'Jornada Normal'
    END AS estado_salud_laboral
FROM empleados e
LEFT JOIN registro_horas r 
    ON e.id_empleado = r.id_empleado 
   AND r.fecha BETWEEN DATE_TRUNC('week', CURRENT_DATE)::DATE 
                   AND (DATE_TRUNC('week', CURRENT_DATE) + INTERVAL '6 days')::DATE
GROUP BY e.id_empleado, e.nombre, e.apellido, e.cargo, e.max_horas_semanales;